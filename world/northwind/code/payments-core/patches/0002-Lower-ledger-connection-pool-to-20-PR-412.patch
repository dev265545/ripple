From e643c16ba02303a56e7504cb8fb6210c838594ee Mon Sep 17 00:00:00 2001
From: Asha Rao <asha@northwindpay.example>
Date: Sun, 4 Oct 2026 09:00:00 +0000
Subject: [PATCH 2/2] Lower ledger connection pool to 20 (PR-412)

Implements ADR-7.
---
 payments/config.py       | 2 +-
 tests/test_ledger_cap.py | 8 ++++++++
 2 files changed, 9 insertions(+), 1 deletion(-)
 create mode 100644 tests/test_ledger_cap.py

diff --git a/payments/config.py b/payments/config.py
index 3ab508f..07b6b90 100644
--- a/payments/config.py
+++ b/payments/config.py
@@ -1,3 +1,3 @@
-LEDGER_POOL_SIZE = 100
+LEDGER_POOL_SIZE = 20
 PODS = 4
 LEDGER_MAX_CONNECTIONS = 100
diff --git a/tests/test_ledger_cap.py b/tests/test_ledger_cap.py
new file mode 100644
index 0000000..e731e8b
--- /dev/null
+++ b/tests/test_ledger_cap.py
@@ -0,0 +1,8 @@
+import unittest
+
+from payments.config import LEDGER_MAX_CONNECTIONS, LEDGER_POOL_SIZE, PODS
+
+
+class LedgerCapTest(unittest.TestCase):
+    def test_all_pods_together_stay_under_the_ledger_connection_limit(self):
+        self.assertLessEqual(LEDGER_POOL_SIZE * PODS, LEDGER_MAX_CONNECTIONS)
-- 
