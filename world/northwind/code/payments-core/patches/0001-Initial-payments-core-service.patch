@@ -0,0 +1,21 @@
+import unittest
+
+from payments.charges import serve_burst
+from payments.pool import Pool, PoolExhausted
+
+
+class ChargesTest(unittest.TestCase):
+    def test_pool_refuses_when_every_connection_is_in_use(self):
+        pool = Pool(2)
+        pool.acquire()
+        pool.acquire()
+        with self.assertRaises(PoolExhausted):
+            pool.acquire()
+
+    def test_burst_within_pool_size_is_fully_served(self):
+        self.assertEqual(serve_burst(Pool(10), 8), {"served": 8, "failed": 0})
+
+    def test_connections_are_returned_after_a_burst(self):
+        pool = Pool(10)
+        serve_burst(pool, 8)
+        self.assertEqual(pool.in_use, 0)
