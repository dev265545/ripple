--- /dev/null
+++ b/payments/pool.py
@@ -0,0 +1,16 @@
+class PoolExhausted(Exception):
+    pass
+
+
+class Pool:
+    def __init__(self, size: int) -> None:
+        self.size = size
+        self.in_use = 0
+
+    def acquire(self) -> None:
+        if self.in_use >= self.size:
+            raise PoolExhausted(f"all {self.size} ledger connections are in use")
+        self.in_use += 1
+
+    def release(self) -> None:
+        self.in_use -= 1
