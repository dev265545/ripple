@@ -0,0 +1,20 @@
+import subprocess
+import sys
+import time
+
+from waf.engine import inspect
+
+LIMIT_SECONDS = 1.0
+WORST_CASE_BODY = "1" * 4000
+
+if "--inspect" in sys.argv:
+    inspect(WORST_CASE_BODY)
+    sys.exit(0)
+
+started = time.monotonic()
+try:
+    subprocess.run([sys.executable, __file__, "--inspect"], timeout=LIMIT_SECONDS, check=True)
+except subprocess.TimeoutExpired:
+    print(f"one {len(WORST_CASE_BODY)}-character request body held a CPU core in the WAF for over {LIMIT_SECONDS:.0f}s; every request behind it waits")
+    sys.exit(1)
+print(f"worst-case {len(WORST_CASE_BODY)}-character request body inspected in {(time.monotonic() - started) * 1000:.0f} ms")
