{"uri":"payments-core/tests/test_charges.py","hash":"a2d29437667ae3402ab5f50c99b95dc54bf731a0","fetched_at":"2026-10-31T22:39:53Z","text":"import unittest\n\nfrom payments.charges import serve_burst\nfrom payments.pool import Pool, PoolExhausted\n\n\nclass ChargesTest(unittest.TestCase):\n    def test_pool_refuses_when_every_connection_is_in_use(self):\n        pool = Pool(2)\n        pool.acquire()\n        pool.acquire()\n        with self.assertRaises(PoolExhausted):\n            pool.acquire()\n\n    def test_burst_within_pool_size_is_fully_served(self):\n        self.assertEqual(serve_burst(Pool(10), 8), {\"served\": 8, \"failed\": 0})\n\n    def test_connections_are_returned_after_a_burst(self):\n        pool = Pool(10)\n        serve_burst(pool, 8)\n        self.assertEqual(pool.in_use, 0)\n","source":"Code index","id":"code:payments-core:tests/test_charges.py","nodes":[{"kind":"File","id":"payments-core:tests/test_charges.py","name":"tests/test_charges.py","quote":null,"inferred":false},{"kind":"Symbol","id":"payments-core:tests.test_charges.ChargesTest","name":"ChargesTest","quote":null,"inferred":false},{"kind":"Symbol","id":"payments-core:tests.test_charges.ChargesTest.test_burst_within_pool_size_is_fully_served","name":"ChargesTest.test_burst_within_pool_size_is_fully_served","quote":null,"inferred":false},{"kind":"Symbol","id":"payments-core:tests.test_charges.ChargesTest.test_connections_are_returned_after_a_burst","name":"ChargesTest.test_connections_are_returned_after_a_burst","quote":null,"inferred":false},{"kind":"Symbol","id":"payments-core:tests.test_charges.ChargesTest.test_pool_refuses_when_every_connection_is_in_use","name":"ChargesTest.test_pool_refuses_when_every_connection_is_in_use","quote":null,"inferred":false}],"edges":[{"source":"File:payments-core:tests/test_charges.py","relation":"DEFINES","target":"Symbol:payments-core:tests.test_charges.ChargesTest","quote":null,"inferred":false},{"source":"File:payments-core:tests/test_charges.py"