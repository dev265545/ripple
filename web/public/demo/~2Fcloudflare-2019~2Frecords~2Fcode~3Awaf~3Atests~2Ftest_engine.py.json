{"uri":"waf/tests/test_engine.py","hash":"0cc3c14865bbb68706e6450752cb1caedaf71555","fetched_at":"2026-10-31T22:39:59Z","text":"import unittest\n\nfrom waf.engine import inspect\n\n\nclass EngineTest(unittest.TestCase):\n    def test_known_attacks_are_matched(self):\n        self.assertEqual(inspect(\"id=1 UNION SELECT password FROM users\"), [\"100001\"])\n        self.assertEqual(inspect(\"file=../../etc/passwd\"), [\"100002\"])\n\n    def test_inline_javascript_is_matched_however_it_is_written(self):\n        for body in [\"q=';alert(document.cookie);x=1\", \"1;location=evil\", \"null;top.location=1\", \"`-x=document.cookie\", \"\\\"]}+ window.name = 1\"]:\n            self.assertEqual(inspect(body), [\"100043\"], body)\n\n    def test_ordinary_requests_pass(self):\n        self.assertEqual(inspect(\"hello world\"), [])\n","source":"Code index","id":"code:waf:tests/test_engine.py","nodes":[{"kind":"File","id":"waf:tests/test_engine.py","name":"tests/test_engine.py","quote":null,"inferred":false},{"kind":"Symbol","id":"waf:tests.test_engine.EngineTest","name":"EngineTest","quote":null,"inferred":false},{"kind":"Symbol","id":"waf:tests.test_engine.EngineTest.test_inline_javascript_is_matched_however_it_is_written","name":"EngineTest.test_inline_javascript_is_matched_however_it_is_written","quote":null,"inferred":false},{"kind":"Symbol","id":"waf:tests.test_engine.EngineTest.test_known_attacks_are_matched","name":"EngineTest.test_known_attacks_are_matched","quote":null,"inferred":false},{"kind":"Symbol","id":"waf:tests.test_engine.EngineTest.test_ordinary_requests_pass","name":"EngineTest.test_ordinary_requests_pass","quote":null,"inferred":false}],"edges":[{"source":"File:waf:tests/test_engine.py","relation":"DEFINES","target":"Symbol:waf:tests.test_engine.EngineTest","quote":null,"inferred":false},{"source":"File:waf:tests/test_engine.py","relation":"DEFINES","target":"Symbol:waf:tests.test_engine.EngineTest.test_inline_javascript_is_matched_however_it_is_written"