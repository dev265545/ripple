{"uri":"payments-core/payments/charges.py","hash":"26017d647bc1f5beac4f29a6a159fba5404a374d","fetched_at":"2026-10-31T22:39:53Z","text":"from payments.pool import Pool, PoolExhausted\n\n\ndef serve_burst(pool: Pool, charges: int) -> dict[str, int]:\n    \"\"\"Charges arriving in the same instant; each holds one ledger connection until it completes.\"\"\"\n    served = failed = 0\n    for _ in range(charges):\n        try:\n            pool.acquire()\n            served += 1\n        except PoolExhausted:\n            failed += 1\n    for _ in range(served):\n        pool.release()\n    return {\"served\": served, \"failed\": failed}\n","source":"Code index","id":"code:payments-core:payments/charges.py","nodes":[{"kind":"File","id":"payments-core:payments/charges.py","name":"payments/charges.py","quote":null,"inferred":false},{"kind":"Symbol","id":"payments-core:payments.charges.serve_burst","name":"serve_burst","quote":null,"inferred":false}],"edges":[{"source":"File:payments-core:payments/charges.py","relation":"DEFINES","target":"Symbol:payments-core:payments.charges.serve_burst","quote":null,"inferred":false},{"source":"Service:payments-core","relation":"HAS_CODE","target":"File:payments-core:payments/charges.py","quote":null,"inferred":false},{"source":"Symbol:payments-core:payments.charges.serve_burst","relation":"REFERENCES","target":"Symbol:payments-core:payments.pool.Pool","quote":null,"inferred":false},{"source":"Symbol:payments-core:payments.charges.serve_burst","relation":"REFERENCES","target":"Symbol:payments-core:payments.pool.Pool.acquire","quote":null,"inferred":false},{"source":"Symbol:payments-core:payments.charges.serve_burst","relation":"REFERENCES","target":"Symbol:payments-core:payments.pool.Pool.release","quote":null,"inferred":false},{"source":"Symbol:payments-core:payments.charges.serve_burst","relation":"REFERENCES","target":"Symbol:payments-core:payments.pool.PoolExhausted","quote":null,"inferred":false}]}