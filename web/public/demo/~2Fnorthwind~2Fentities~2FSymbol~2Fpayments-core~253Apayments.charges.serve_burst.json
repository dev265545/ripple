{"kind":"Symbol","id":"payments-core:payments.charges.serve_burst","props":{"id":"payments-core:payments.charges.serve_burst","name":"serve_burst","kind":"function","path":"payments/charges.py","line":4,"code":"def serve_burst(pool: Pool, charges: int) -> dict[str, int]:\n    \"\"\"Charges arriving in the same instant; each holds one ledger connection until it completes.\"\"\"\n    served = failed = 0\n    for _ in range(charges):\n        try:\n            pool.acquire()\n            served += 1\n        except PoolExhausted:\n            failed += 1\n    for _ in range(served):\n        pool.release()\n    return {\"served\": served, \"failed\": failed}"},"neighbours":[{"relation":"DEFINES","outgoing":false,"kind":"File","id":"payments-core:payments/charges.py","name":"payments/charges.py","quote":null,"src":"code:payments-core:payments/charges.py","at":null},{"relation":"REFERENCES","outgoing":false,"kind":"Symbol","id":"payments-core:loadcheck.result","name":"result","quote":null,"src":"code:payments-core:loadcheck.py","at":null},{"relation":"REFERENCES","outgoing":true,"kind":"Symbol","id":"payments-core:payments.pool.Pool","name":"Pool","quote":null,"src":"code:payments-core:payments/charges.py","at":null},{"relation":"REFERENCES","outgoing":true,"kind":"Symbol","id":"payments-core:payments.pool.Pool.acquire","name":"Pool.acquire","quote":null,"src":"code:payments-core:payments/charges.py","at":null},{"relation":"REFERENCES","outgoing":true,"kind":"Symbol","id":"payments-core:payments.pool.Pool.release","name":"Pool.release","quote":null,"src":"code:payments-core:payments/charges.py","at":null},{"relation":"REFERENCES","outgoing":true,"kind":"Symbol","id":"payments-core:payments.pool.PoolExhausted","name":"PoolExhausted","quote":null,"src":"code:payments-core:payments/charges.py","at":null},{"relation":"REFERENCES","outgoing":false,"kind":"Symbol","id":"payments-core:tests.test_charges.ChargesTest.test_burst_within_pool_size_is_fully_served","name":"ChargesTes