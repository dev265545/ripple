{"uri":"payments-core/payments/pool.py","hash":"60ecb761eb14d3f1a90e91b0eccb308555182af3","fetched_at":"2026-10-31T22:39:53Z","text":"class PoolExhausted(Exception):\n    pass\n\n\nclass Pool:\n    def __init__(self, size: int) -> None:\n        self.size = size\n        self.in_use = 0\n\n    def acquire(self) -> None:\n        if self.in_use >= self.size:\n            raise PoolExhausted(f\"all {self.size} ledger connections are in use\")\n        self.in_use += 1\n\n    def release(self) -> None:\n        self.in_use -= 1\n","source":"Code index","id":"code:payments-core:payments/pool.py","nodes":[{"kind":"File","id":"payments-core:payments/pool.py","name":"payments/pool.py","quote":null,"inferred":false},{"kind":"Symbol","id":"payments-core:payments.pool.Pool","name":"Pool","quote":null,"inferred":false},{"kind":"Symbol","id":"payments-core:payments.pool.Pool.__init__","name":"Pool.__init__","quote":null,"inferred":false},{"kind":"Symbol","id":"payments-core:payments.pool.Pool.acquire","name":"Pool.acquire","quote":null,"inferred":false},{"kind":"Symbol","id":"payments-core:payments.pool.Pool.release","name":"Pool.release","quote":null,"inferred":false},{"kind":"Symbol","id":"payments-core:payments.pool.PoolExhausted","name":"PoolExhausted","quote":null,"inferred":false}],"edges":[{"source":"File:payments-core:payments/pool.py","relation":"DEFINES","target":"Symbol:payments-core:payments.pool.Pool","quote":null,"inferred":false},{"source":"File:payments-core:payments/pool.py","relation":"DEFINES","target":"Symbol:payments-core:payments.pool.Pool.__init__","quote":null,"inferred":false},{"source":"File:payments-core:payments/pool.py","relation":"DEFINES","target":"Symbol:payments-core:payments.pool.Pool.acquire","quote":null,"inferred":false},{"source":"File:payments-core:payments/pool.py","relation":"DEFINES","target":"Symbol:payments-core:payments.pool.Pool.release","quote":null,"inferred":false},{"source":"File:payments-core:payments/pool.py","relation":"DEFIN